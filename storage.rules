rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function walkData(walkId) {
      return firestore.get(/databases/(default)/documents/walks/$(walkId)).data;
    }

    function isWalkHost(walkId) {
      let walk = walkData(walkId);
      return signedIn() && walk != null && walk.hostUid == request.auth.uid;
    }

    // Host or joined participant (chat access).
    function isWalkParticipant(walkId) {
      let walk = walkData(walkId);
      return signedIn()
        && walk != null
        && (
          walk.hostUid == request.auth.uid
          || request.auth.uid in walk.get('joinedUserUids', [])
          || request.auth.uid in walk.get('joinedUids', [])
        );
    }

    // Participant, or anyone with a non-declined participant state (e.g. left early).
    function isWalkMember(walkId) {
      let walk = walkData(walkId);
      let state = walk == null ? null : walk.get('participantStates', {}).get(request.auth.uid, null);
      return isWalkParticipant(walkId) || (state != null && state != 'declined');
    }

    function dmThread(threadId) {
      return firestore.get(/databases/(default)/documents/dm_threads/$(threadId)).data;
    }

    function isDmParticipant(threadId) {
      let thread = dmThread(threadId);
      return signedIn()
        && thread != null
        && (
          request.auth.uid in thread.get('participants', [])
          || request.auth.uid in thread.get('memberIds', [])
        );
    }

    // Walk cover photos: uploaded by the host when creating/editing the walk.
    // Readable by any signed-in user (open walks show them in listings).
    match /walks/{walkId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isWalkHost(walkId) && isImageUpload();
      allow delete: if isWalkHost(walkId);
    }

    // Walk chat images: participants only; uploader file name ends with _<uid>.jpg.
    match /walk_chats/{walkId}/images/{fileName} {
      allow read: if isWalkParticipant(walkId);
      allow create: if isWalkParticipant(walkId)
        && fileName.matches('.*_' + request.auth.uid + '\\.jpg')
        && isImageUpload();
      allow update, delete: if false;
    }

    // Direct message media uploads
    match /dm_media/{threadId}/{fileName} {
      allow read: if isDmParticipant(threadId);
      allow delete: if isDmParticipant(threadId);
      allow create, update: if isDmParticipant(threadId) && isImageUpload();
    }

    // Walk review photos: only members can upload to their own folder
    match /walk_reviews/{walkId}/{userId}/{fileName} {
      allow read: if isWalkMember(walkId);
      allow delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isWalkMember(walkId)
        && isImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
